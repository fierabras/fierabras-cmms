    <!-- P-16 (PPB-02, PPB-03, PPB-21, PPB-22): a purchase order category or a vendor used by a purchase order or a
         workflow is not deleted. Until now deleting it put the purchase order reference in NULL and deleted the
         workflow that cited it. These references become NO ACTION and each child column gets an index. Earlier
         changesets are left untouched. -->

    <changeSet id="2026_11_23_1795481141_purchase_order_category_and_vendor_references_no_action_purchase_order_category_id" author="fierabras">
        <dropForeignKeyConstraint baseTableName="purchase_order" constraintName="fk29o4jh7n4ttmsfh50ulu11hjg"/>
        <addForeignKeyConstraint baseColumnNames="category_id" baseTableName="purchase_order"
                                 constraintName="fk29o4jh7n4ttmsfh50ulu11hjg" referencedColumnNames="id"
                                 referencedTableName="purchase_order_category" onDelete="NO ACTION"/>
        <createIndex tableName="purchase_order" indexName="idx_purchase_order_category_id">
            <column name="category_id"/>
        </createIndex>
        <rollback>
            <dropIndex tableName="purchase_order" indexName="idx_purchase_order_category_id"/>
            <dropForeignKeyConstraint baseTableName="purchase_order" constraintName="fk29o4jh7n4ttmsfh50ulu11hjg"/>
            <addForeignKeyConstraint baseColumnNames="category_id" baseTableName="purchase_order"
                                     constraintName="fk29o4jh7n4ttmsfh50ulu11hjg" referencedColumnNames="id"
                                     referencedTableName="purchase_order_category" onDelete="SET NULL"/>
        </rollback>
    </changeSet>

