    <!-- P-14 (PPB-02, PPB-03, PPB-17, PPB-21, PPB-22): an asset with child assets, meters, requests, preventive
         maintenances, tasks, meter triggers or workflows that cite it is not deleted. Those references become
         NO ACTION; until now deleting the asset deleted its subtree, its meters with their readings, its tasks and
         whole workflows (CASCADE), or put the reference in NULL. Each child column gets an index. NO ACTION, not
         RESTRICT, keeps the deletion of a whole company working: the rows go in the same statement. Earlier
         changesets are left untouched. -->

    <changeSet id="2026_11_22_1795380717_asset_parent_asset_id" author="fierabras">
        <dropForeignKeyConstraint baseTableName="asset" constraintName="fk6qu6wqhpppa2w4y09l3tt4q56"/>
        <addForeignKeyConstraint baseColumnNames="parent_asset_id" baseTableName="asset"
                                 constraintName="fk6qu6wqhpppa2w4y09l3tt4q56" referencedColumnNames="id"
                                 referencedTableName="asset" onDelete="NO ACTION"/>
        <createIndex tableName="asset" indexName="idx_asset_parent_asset_id">
            <column name="parent_asset_id"/>
        </createIndex>
        <rollback>
            <dropIndex tableName="asset" indexName="idx_asset_parent_asset_id"/>
            <dropForeignKeyConstraint baseTableName="asset" constraintName="fk6qu6wqhpppa2w4y09l3tt4q56"/>
            <addForeignKeyConstraint baseColumnNames="parent_asset_id" baseTableName="asset"
                                     constraintName="fk6qu6wqhpppa2w4y09l3tt4q56" referencedColumnNames="id"
                                     referencedTableName="asset" onDelete="CASCADE"/>
        </rollback>
    </changeSet>

