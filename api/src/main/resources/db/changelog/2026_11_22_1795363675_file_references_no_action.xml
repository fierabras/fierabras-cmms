    <!-- P-17 (PPB-18, PPB-21, PPB-22): a file that a record cites is not deleted; FileService answers 409
         FILE_IN_USE first. Each reference to file gets its target rule and an index on its child column. Until now
         deleting a file put these references in NULL, and deleting the audio of a request deleted the request.
         NO ACTION, not RESTRICT, keeps the deletion of a whole company working: the rows go in the same statement.
         The work order revisions (work_order_aud) have no company: a purge deletes them first. The association
         tables and the two signature_id keys keep their rule. Earlier changesets are left untouched. -->

    <changeSet id="2026_11_22_1795363675_asset_image_id" author="fierabras">
        <dropForeignKeyConstraint baseTableName="asset" constraintName="fkhh76eg71adtmdagspxgbnmjd5"/>
        <addForeignKeyConstraint baseColumnNames="image_id" baseTableName="asset"
                                 constraintName="fkhh76eg71adtmdagspxgbnmjd5" referencedColumnNames="id"
                                 referencedTableName="file" onDelete="NO ACTION"/>
        <createIndex tableName="asset" indexName="idx_asset_image_id">
            <column name="image_id"/>
        </createIndex>
        <rollback>
            <dropIndex tableName="asset" indexName="idx_asset_image_id"/>
            <dropForeignKeyConstraint baseTableName="asset" constraintName="fkhh76eg71adtmdagspxgbnmjd5"/>
            <addForeignKeyConstraint baseColumnNames="image_id" baseTableName="asset"
                                     constraintName="fkhh76eg71adtmdagspxgbnmjd5" referencedColumnNames="id"
                                     referencedTableName="file" onDelete="SET NULL"/>
        </rollback>
    </changeSet>

