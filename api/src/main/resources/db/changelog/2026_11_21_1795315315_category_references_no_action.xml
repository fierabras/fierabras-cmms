    <!-- P-12b (PPB-02, PPB-21, PPB-22): a work order, cost or time category that other records cite is not
         deleted; the category services answer 409 <ENTITY>_IN_USE first. Each foreign key gets its target rule and an
         index on its child column. NO ACTION, not RESTRICT, keeps the deletion of a whole company working: the rows
         go in the same statement. The work order revisions (work_order_aud) have no company: a purge deletes them
         first. Earlier changesets are left untouched. -->

    <changeSet id="2026_11_21_1795315315_preventive_maintenance_category_id" author="fierabras">
        <dropForeignKeyConstraint baseTableName="preventive_maintenance" constraintName="fkp1wj9d43qdhi19swp3ab00r4e"/>
        <addForeignKeyConstraint baseColumnNames="category_id" baseTableName="preventive_maintenance"
                                 constraintName="fkp1wj9d43qdhi19swp3ab00r4e" referencedColumnNames="id"
                                 referencedTableName="work_order_category" onDelete="NO ACTION"/>
        <createIndex tableName="preventive_maintenance" indexName="idx_preventive_maintenance_category_id">
            <column name="category_id"/>
        </createIndex>
        <rollback>
            <dropIndex tableName="preventive_maintenance" indexName="idx_preventive_maintenance_category_id"/>
            <dropForeignKeyConstraint baseTableName="preventive_maintenance" constraintName="fkp1wj9d43qdhi19swp3ab00r4e"/>
            <addForeignKeyConstraint baseColumnNames="category_id" baseTableName="preventive_maintenance"
                                     constraintName="fkp1wj9d43qdhi19swp3ab00r4e" referencedColumnNames="id"
                                     referencedTableName="work_order_category" onDelete="SET NULL"/>
        </rollback>
    </changeSet>

