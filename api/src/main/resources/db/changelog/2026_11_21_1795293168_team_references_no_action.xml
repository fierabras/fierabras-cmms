    <!-- P-11 (PPB-21, PPB-22): a team that other records cite is not deleted; the team service answers 409 TEAM_IN_USE first. Each foreign key gets its target rule and an index on its child
         column. NO ACTION, not RESTRICT, keeps the deletion of a whole company working: the rows go in the same
         statement. Earlier changesets are left untouched. -->

    <changeSet id="2026_11_21_1795293168_preventive_maintenance_team_id" author="fierabras">
