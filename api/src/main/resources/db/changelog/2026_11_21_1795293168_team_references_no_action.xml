        <addForeignKeyConstraint baseColumnNames="team_id" baseTableName="preventive_maintenance"
                                 constraintName="fkcp1qytc19odw5ngu7y4lx79me" referencedColumnNames="id"
                                 referencedTableName="team" onDelete="NO ACTION"/>
        <createIndex tableName="preventive_maintenance" indexName="idx_preventive_maintenance_team_id">
            <column name="team_id"/>
        </createIndex>
        <rollback>
            <dropIndex tableName="preventive_maintenance" indexName="idx_preventive_maintenance_team_id"/>
            <dropForeignKeyConstraint baseTableName="preventive_maintenance" constraintName="fkcp1qytc19odw5ngu7y4lx79me"/>
