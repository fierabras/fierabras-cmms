    <!-- P-15 (E-9, PPB-17, PPB-21, PPB-22): a preventive maintenance that generated work orders, the schedule of a
         preventive maintenance, a task definition used by a task and a checklist cited by an automation are
         protected references (NO ACTION); the custom field values of a preventive maintenance and the options of a
         task definition are part of them (CASCADE). Each child column leads an index. Earlier changesets are left
         untouched. -->

    <changeSet id="2026_11_25_1795650000_work_order_parent_preventive_maintenance_id" author="fierabras">
        <dropForeignKeyConstraint baseTableName="work_order" constraintName="fkajaqh96l0dquvxdfw8fj77241"/>
        <addForeignKeyConstraint baseColumnNames="parent_preventive_maintenance_id" baseTableName="work_order"
                                 constraintName="fkajaqh96l0dquvxdfw8fj77241" referencedColumnNames="id"
                                 referencedTableName="preventive_maintenance" onDelete="NO ACTION"/>
        <createIndex tableName="work_order" indexName="idx_work_order_parent_preventive_maintenance_id">
            <column name="parent_preventive_maintenance_id"/>
        </createIndex>
        <rollback>
            <dropIndex tableName="work_order" indexName="idx_work_order_parent_preventive_maintenance_id"/>
            <dropForeignKeyConstraint baseTableName="work_order" constraintName="fkajaqh96l0dquvxdfw8fj77241"/>
            <addForeignKeyConstraint baseColumnNames="parent_preventive_maintenance_id" baseTableName="work_order"
                                     constraintName="fkajaqh96l0dquvxdfw8fj77241" referencedColumnNames="id"
                                     referencedTableName="preventive_maintenance" onDelete="SET NULL"/>
        </rollback>
    </changeSet>

