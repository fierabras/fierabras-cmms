    <!-- P-11 (PPB-21, PPB-22): the configuration of an organization is never deleted by the application (PPB-10): references to it are protected, and the field configurations belong to their configuration. Each foreign key gets its target rule and an index on its child
         column. NO ACTION, not RESTRICT, keeps the deletion of a whole company working: the rows go in the same
         statement. Earlier changesets are left untouched. -->

    <changeSet id="2026_11_21_1795293171_company_company_settings_id" author="fierabras">
        <dropForeignKeyConstraint baseTableName="company" constraintName="fkfv376ws8n2akfbxvagtxbkiu2"/>
        <addForeignKeyConstraint baseColumnNames="company_settings_id" baseTableName="company"
                                 constraintName="fkfv376ws8n2akfbxvagtxbkiu2" referencedColumnNames="id"
                                 referencedTableName="company_settings" onDelete="NO ACTION"/>
        <createIndex tableName="company" indexName="idx_company_company_settings_id">
            <column name="company_settings_id"/>
        </createIndex>
        <rollback>
            <dropIndex tableName="company" indexName="idx_company_company_settings_id"/>
            <dropForeignKeyConstraint baseTableName="company" constraintName="fkfv376ws8n2akfbxvagtxbkiu2"/>
            <addForeignKeyConstraint baseColumnNames="company_settings_id" baseTableName="company"
                                     constraintName="fkfv376ws8n2akfbxvagtxbkiu2" referencedColumnNames="id"
                                     referencedTableName="company_settings" onDelete="CASCADE"/>
