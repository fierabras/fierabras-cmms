    <!-- P-14 (PPB-02, PPB-03, PPB-04, PPB-21, PPB-22): a location with child locations, or cited by assets, meters,
         users, preventive maintenances, requests, work orders and their revisions, meter triggers or workflows, is
         not deleted. Those references become NO ACTION; until now deleting the location deleted its subtree and
         whole workflows (CASCADE), or put the reference in NULL, revisions included. Each child column gets an
         index. NO ACTION, not RESTRICT, keeps the deletion of a whole company working. Earlier changesets are left
         untouched. -->

    <changeSet id="2026_11_22_1795381894_asset_location_id" author="fierabras">
        <dropForeignKeyConstraint baseTableName="asset" constraintName="fkoo11h2f4j12wv0axk6d8u1wy0"/>
        <addForeignKeyConstraint baseColumnNames="location_id" baseTableName="asset"
                                 constraintName="fkoo11h2f4j12wv0axk6d8u1wy0" referencedColumnNames="id"
                                 referencedTableName="location" onDelete="NO ACTION"/>
        <createIndex tableName="asset" indexName="idx_asset_location_id">
            <column name="location_id"/>
        </createIndex>
        <rollback>
            <dropIndex tableName="asset" indexName="idx_asset_location_id"/>
            <dropForeignKeyConstraint baseTableName="asset" constraintName="fkoo11h2f4j12wv0axk6d8u1wy0"/>
            <addForeignKeyConstraint baseColumnNames="location_id" baseTableName="asset"
                                     constraintName="fkoo11h2f4j12wv0axk6d8u1wy0" referencedColumnNames="id"
                                     referencedTableName="location" onDelete="SET NULL"/>
        </rollback>
    </changeSet>

